{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/spark-engine/blob/main/schemas/fusion-qualification-case.schema.json",
  "title": "Fusion Qualification Case Manifest",
  "description": "Structural schema for reproducible fusion engineering cases. Structural validity is not physical validation or engineering qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "case_class",
    "intended_use",
    "created_on",
    "time_bases",
    "physical_boundaries",
    "flows",
    "quantities",
    "models",
    "uncertainty_models",
    "evidence_artifacts",
    "validation_plan",
    "observables",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "case_class": {
      "enum": [
        "synthetic_fixture",
        "analytic_reference",
        "literature_reference",
        "code_to_code_comparison",
        "experimental_validation",
        "engineering_qualification"
      ]
    },
    "intended_use": {
      "enum": [
        "schema_conformance",
        "software_verification",
        "numerical_verification",
        "model_validation",
        "design_screening",
        "engineering_qualification",
        "operational_assessment"
      ]
    },
    "concept_family": {
      "type": "string",
      "minLength": 1
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "time_bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/timeBasis"
      }
    },
    "physical_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "quantities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quantity"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "uncertainty_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "validation_plan": {
      "$ref": "#/$defs/validationPlan"
    },
    "observables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observable"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code"
      ],
      "properties": {
        "system": {
          "const": "UCUM"
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "steady_state",
            "finite_window_average",
            "time_series",
            "mission_profile",
            "campaign",
            "lifetime"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "time_origin": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "finite_window_average"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "duration_seconds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "time_series"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "duration_seconds",
              "sample_interval_seconds"
            ]
          }
        }
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "domain",
        "role",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "plasma",
            "neutronics",
            "materials",
            "thermal_hydraulics",
            "mechanical",
            "fuel_cycle",
            "electrical",
            "maintenance",
            "finance",
            "grid",
            "other"
          ]
        },
        "role": {
          "enum": [
            "fusion_source",
            "confined_plasma",
            "separatrix",
            "scrape_off_layer",
            "energy_extraction_surface",
            "first_wall",
            "blanket",
            "divertor_target_wetted_surface",
            "coolant",
            "heat_exchanger",
            "power_conversion",
            "electrical_bus",
            "recirculating_load",
            "grid_connection",
            "tritium_inventory_control_volume",
            "fuel_cycle_interface",
            "component",
            "maintenance_resource",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "geometry_artifact_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_boundary_id",
        "to_boundary_id",
        "quantity_name",
        "quantity_kind",
        "value",
        "unit",
        "time_basis_id",
        "evidence_artifact_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from_boundary_id": {
          "$ref": "#/$defs/id"
        },
        "to_boundary_id": {
          "$ref": "#/$defs/id"
        },
        "quantity_name": {
          "type": "string",
          "minLength": 1
        },
        "quantity_kind": {
          "enum": [
            "power",
            "energy",
            "heat_flux",
            "mass_flow",
            "mass",
            "particle_rate",
            "tritium_flow",
            "electric_power",
            "electrical_energy",
            "temperature",
            "pressure",
            "other"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "time_basis_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "uncertainty_model_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "quantity_kind",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity_kind": {
          "enum": [
            "power",
            "energy",
            "heat_flux",
            "mass_flow",
            "mass",
            "particle_rate",
            "tritium_inventory",
            "temperature",
            "pressure",
            "stress",
            "strain",
            "damage",
            "lifetime",
            "availability",
            "cost",
            "price",
            "probability",
            "other"
          ]
        },
        "status": {
          "enum": [
            "known",
            "unknown",
            "out_of_domain"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "physical_boundary_id": {
          "$ref": "#/$defs/id"
        },
        "time_basis_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "uncertainty_model_id": {
          "$ref": "#/$defs/id"
        },
        "unknown_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "unit",
              "physical_boundary_id",
              "time_basis_id",
              "evidence_artifact_ids"
            ],
            "not": {
              "required": [
                "unknown_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "out_of_domain"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "unknown_reason"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "representation",
        "description",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "aleatory",
            "epistemic",
            "model_discrepancy"
          ]
        },
        "representation": {
          "enum": [
            "interval",
            "distribution",
            "ensemble",
            "scenario_set",
            "qualitative"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "minProperties": 1
        },
        "dependence_group": {
          "type": "string"
        },
        "dependence_assumption": {
          "type": "string"
        },
        "sampling_method": {
          "type": "string"
        },
        "source_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "discipline",
        "version",
        "revision",
        "domain_of_validity",
        "input_artifact_ids",
        "output_artifact_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "discipline": {
          "enum": [
            "plasma_physics",
            "neutronics",
            "exhaust",
            "materials",
            "thermal_hydraulics",
            "mechanical",
            "power_conversion",
            "fuel_cycle",
            "rami",
            "maintenance",
            "finance",
            "optimization",
            "accounting",
            "other"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "executable_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "domain_of_validity": {
          "type": "object",
          "required": [
            "summary",
            "status"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "in_domain",
                "partially_supported",
                "unknown",
                "out_of_domain"
              ]
            },
            "supported_concept_families": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "known_exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "input_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "output_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_class",
        "claim",
        "locator",
        "license",
        "content_digest_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "scenario_assumption",
            "literature_reported",
            "measured",
            "code_to_code_comparison",
            "experimental_validation",
            "engineering_qualification"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        },
        "content_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "frozen_before_tuning",
        "splits"
      ],
      "properties": {
        "protocol_id": {
          "$ref": "#/$defs/id"
        },
        "frozen_before_tuning": {
          "type": "boolean"
        },
        "split_grouping_key": {
          "type": "string"
        },
        "splits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "dataset_artifact_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "role": {
                "enum": [
                  "analytic_fixture",
                  "calibration",
                  "validation",
                  "holdout"
                ]
              },
              "dataset_artifact_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "expected_value",
        "unit",
        "metric",
        "tolerance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected_value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "metric": {
          "enum": [
            "absolute_error",
            "relative_error",
            "absolute_residual",
            "relative_residual",
            "bias",
            "rmse",
            "nrmse",
            "interval_coverage",
            "false_safe_rate",
            "other"
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "reference_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_basis",
        "blockers",
        "supporting_evidence_artifact_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "indeterminate",
            "not_qualified",
            "qualified",
            "rejected",
            "out_of_domain"
          ]
        },
        "decision_basis": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_evidence_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "independent_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_process",
            "reviewer_or_body",
            "reviewed_on",
            "scope"
          ],
          "properties": {
            "review_process": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_or_body": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_on": {
              "type": "string",
              "format": "date"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "qualified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "independent_review"
            ],
            "properties": {
              "supporting_evidence_artifact_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "indeterminate"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "digest_scope",
        "digest_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "RFC8785"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "digest_scope": {
          "const": "manifest_without_integrity"
        },
        "digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
